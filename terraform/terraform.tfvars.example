# Copy to terraform.tfvars (which is git-ignored) and fill in your values.
# NEVER put the API token in this file.
account_id        = "your_cloudflare_account_id"
worker_name       = "student-task-manager"
kv_namespace_name = "student_tasks"
environment       = "dev"
app_title         = "Student Task Manager"
workers_subdomain = "your-workers-subdomain"
