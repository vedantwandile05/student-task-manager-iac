# Needed for STEP 25-26 (CI/CD). A GitHub Actions runner is destroyed after every run,
# so the Terraform state must live somewhere persistent.
# Free option: HCP Terraform (app.terraform.io), execution mode = "Local".
#
# 1. Create a free HCP Terraform org + a workspace (CLI-driven), set Execution Mode = Local
# 2. Copy this file to backend.tf and fill in organization / workspace
# 3. Run: terraform init -migrate-state
terraform {
  cloud {
    organization = "your-org-name"

    workspaces {
      name = "student-task-manager-dev"
    }
  }
}
